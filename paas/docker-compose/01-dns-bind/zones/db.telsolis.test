$TTL 3600
@   IN  SOA ns1.telsolis.test. admin.telsolis.test. (
        2026110901  ; serial (subirlo cada vez que se edite la zona)
        3600        ; refresh
        900         ; retry
        604800      ; expire
        300 )       ; negative TTL

@       IN  NS  ns1.telsolis.test.
ns1     IN  A   192.168.40.171
pbx     IN  A   192.168.40.170
docker  IN  A   192.168.40.171
