$TTL 3600
@   IN  SOA ns1.telsolis.test. admin.telsolis.test. (
        2026112304  ; serial (subirlo cada vez que se edite la zona)
        3600        ; refresh
        900         ; retry
        604800      ; expire
        300 )       ; negative TTL

@       IN  NS  ns1.telsolis.test.

; LAN del examen: red solo-anfitrion 192.168.56.0/24
ns1     IN  A   192.168.56.10
docker  IN  A   192.168.56.10
db      IN  A   192.168.56.11
web     IN  A   192.168.56.12
k8s     IN  A   192.168.56.13
pbx     IN  A   192.168.56.20
owncloud IN  A   192.168.56.10
mail     IN  A   192.168.56.10
@        IN  MX  10 mail.telsolis.test.
mysql    IN  A   192.168.56.10
