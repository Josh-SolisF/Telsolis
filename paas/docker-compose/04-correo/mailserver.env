# Telsolis: configuración de docker-mailserver para el dominio telsolis.test
OVERRIDE_HOSTNAME=mail.telsolis.test
POSTMASTER_ADDRESS=postmaster@telsolis.test
LOG_LEVEL=info

# TLS con el certificado firmado por la CA propia (Telsolis Root CA)
SSL_TYPE=manual
SSL_CERT_PATH=/tmp/dms/custom-certs/mail.telsolis.test.crt
SSL_KEY_PATH=/tmp/dms/custom-certs/mail.telsolis.test.key

# Protocolos: IMAP para leer buzones; POP3 apagado
ENABLE_IMAP=1
ENABLE_POP3=0

# Filtros apagados para que sea liviano (dominio interno de laboratorio)
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_AMAVIS=0
ENABLE_FAIL2BAN=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0

# Seguridad: nadie envía sin autenticarse ni puede hacerse pasar por otra cuenta
PERMIT_DOCKER=none
SPOOF_PROTECTION=1
