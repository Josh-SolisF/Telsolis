# Telsolis: perfil "{{ item.0.cliente }}" ({{ item.0.dev | upper }}, TCP {{ item.0.puerto }}) - generado por Ansible
# Contiene una llave privada: no compartir ni subir al repositorio.
client
dev {{ item.0.dev }}
proto tcp
remote {{ vpn_ip_publica }} {{ item.0.puerto }}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
verb 3

<ca>
{{ ca_crt.content | b64decode | trim }}
</ca>
<cert>
{{ item.1.content | b64decode | regex_search('-----BEGIN CERTIFICATE-----[\\s\\S]+?-----END CERTIFICATE-----') }}
</cert>
<key>
{{ item.2.content | b64decode | trim }}
</key>
<tls-crypt>
{{ ta_key.content | b64decode | trim }}
</tls-crypt>
