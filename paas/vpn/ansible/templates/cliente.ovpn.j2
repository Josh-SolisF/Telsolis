# Telsolis: perfil "{{ item.cliente }}" ({{ item.dev | upper }}, TCP {{ item.puerto }}) - generado por Ansible
# Contiene una llave privada: no compartir ni subir al repositorio.
client
dev {{ item.dev }}
proto tcp
remote {{ vpn_ip_publica }} {{ item.puerto }}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
verb 3
{% if not item.ruta_todo %}
# Este equipo solo usa el túnel para recibir visitas: no cambiar su ruta a internet ni su DNS
pull-filter ignore "redirect-gateway"
pull-filter ignore "dhcp-option"
{% endif %}

<ca>
{{ lookup('file', pki_local ~ '/pki/ca.crt') }}
</ca>
<cert>
{{ lookup('file', pki_local ~ '/pki/issued/' ~ item.cliente ~ '.crt') | regex_search('-----BEGIN CERTIFICATE-----[\\s\\S]+?-----END CERTIFICATE-----') }}
</cert>
<key>
{{ lookup('file', pki_local ~ '/pki/private/' ~ item.cliente ~ '.key') }}
</key>
<tls-crypt>
{{ lookup('file', pki_local ~ '/pki/ta.key') }}
</tls-crypt>
